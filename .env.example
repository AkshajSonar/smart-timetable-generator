# Database (Docker Compose Postgres)
# API connection uses the restricted app_user role (subject to RLS)
DATABASE_URL=postgresql+asyncpg://app_user:app_password@127.0.0.1:5433/timetable_db
# Alembic migrations use the superuser role
DATABASE_URL_SYNC=postgresql://timetable:timetable@127.0.0.1:5433/timetable_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (stubbed in Phase 1)
JWT_ISSUER_URL=

# Rule parser LLM (Phase 6)
OPENAI_API_KEY=your_openai_api_key_here

# Solver
SOLVER_TIMEOUT_SECONDS=30
